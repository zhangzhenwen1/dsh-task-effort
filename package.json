{
  "name": "dsh-task-effort",
  "version": "0.2.1",
  "type": "module",
  "main": "index.js",
  "description": "Auto-adjust model reasoning effort per task: off/low/high/max with task classification, peak-pricing-period capping, countdown notices, and in-turn error escalation",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "dsh",
    "reasoning-effort",
    "cost-saving",
    "peak-pricing"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "lib",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-plugin-manager"
      ]
    }
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zhangzhenwen1/dsh-task-effort.git"
  },
  "homepage": "https://github.com/zhangzhenwen1/dsh-task-effort"
}
